[global]
type=global
user_agent=Asterisk-Azure-Agent

; 1. SIP Transport Configuration (Port 5070 + Azure Public IP)
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5070
external_media_address=${PUBLIC_IP}
external_signaling_address=${PUBLIC_IP}

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5071
external_media_address=${PUBLIC_IP}
external_signaling_address=${PUBLIC_IP}
keep_alive=30

; 2. Local Softphone Endpoint (MicroSIP Extension 1000)
[1000]
type=endpoint
transport=transport-tcp
context=from-softphone
disallow=all
allow=ulaw,alaw,opus
auth=auth1000
aors=aor1000
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[auth1000]
type=auth
auth_type=userpass
username=1000
password=${PJSIP_SECRET}

[aor1000]
type=aor
max_contacts=5
remove_existing=yes

; 3. LiveKit SIP Trunk Endpoint
[livekit-trunk]
type=endpoint
transport=transport-udp
context=from-asterisk
disallow=all
allow=ulaw,alaw,opus
aors=livekit-aor

[livekit-aor]
type=aor
contact=sip:host.docker.internal:5060